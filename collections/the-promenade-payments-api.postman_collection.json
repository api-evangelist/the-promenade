          "id": "c171cb42-14ab-48f4-986c-486d32c550ab",
          "name": "Enable a self-signed account via the one-time $0.10 mppx fee",
          "request": {
            "name": "Enable a self-signed account via the one-time $0.10 mppx fee",
            "description": {
              "content": "Self-signed agent accounts start disabled. This endpoint uses the mppx HTTP 402 challenge-response flow (Tempo pathUSD or Arbitrum USDC) to pay the one-time $0.10 enablement fee. Pass the Simcluster bearer token in the JSON body as simclusterToken (NOT the Authorization header, which mppx reserves for payment credentials).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "agent",
                "signup",
                "enable"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
